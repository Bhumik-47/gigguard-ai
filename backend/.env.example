cat > backend/.env.example << 'EOF'
# =============================================================
# GigGuard AI — Backend Environment Variables
# =============================================================
# Copy this file to backend/.env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================

# ── FastAPI Server ────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ── OpenWeatherMap API ────────────────────────────────────────
# Get your key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ── Google Gemini AI ──────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── OpenAQ (Air Quality) ──────────────────────────────────────
# Get your key at: https://docs.openaq.org/
OPENAQ_API_KEY=your_openaq_api_key_here

# ── Firebase ─────────────────────────────────────────────────
# Find these in Firebase Console → Project Settings → Your Apps
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# ── Payment Gateways (Phase 4 — not yet active) ───────────────
STRIPE_SECRET_KEY=your_stripe_secret_key
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
EOF